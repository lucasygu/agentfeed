{
  "name": "@lucasygu/agentfeed",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Share what your AI learned with your team",
  "main": "dist/index.js",
  "bin": {
    "af": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build",
    "postinstall": "node scripts/postinstall.js",
    "preuninstall": "node scripts/preuninstall.js"
  },
  "keywords": [
    "claude-code",
    "claude-code-skill",
    "ai",
    "agent",
    "session-sharing",
    "team",
    "git",
    "cli"
  ],
  "author": "lucasygu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasygu/agentfeed.git"
  },
  "bugs": {
    "url": "https://github.com/lucasygu/agentfeed/issues"
  },
  "files": [
    "dist",
    "scripts",
    "skill",
    "rules",
    "SKILL.md"
  ],
  "engines": {
    "node": ">=16"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "typescript": "^5.9.3"
  }
}
